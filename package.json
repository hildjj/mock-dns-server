{
  "name": "mock-dns-server",
  "version": "2.0.0",
  "decription": "Mock DNS-over-TLS server which doesn't use OS sockets",
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "./lib"
  ],
  "keywords": [
    "dns",
    "tls",
    "dns-over-tls"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hildjj/mock-dns-server.git"
  },
  "homepage": "https://github.com/hildjj/mock-dns-server#readme",
  "bugs": {
    "url": "https://github.com/hildjj/mock-dns-server/issues"
  },
  "scripts": {
    "clean": "rimraf coverage docs lib",
    "lint": "eslint .",
    "pretest": "tsc --inlineSourceMap",
    "test": "c8 node --test test/*.test.js",
    "posttest": "npm run ts",
    "docs": "typedoc",
    "ts": "tsc",
    "build": "npm run test && npm run lint && npm run docs && npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "p-event": "^8.0.1",
    "rimraf": "^6.1.3",
    "superc8": "^12.7.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@cto.af/eslint-config": "7.0.4",
    "dns-packet": "~5.6.1",
    "mock-tls-server": "~2.0.0",
    "nofilter": "~7.0.0",
    "typescript-eslint": "~8.72.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  }
}
